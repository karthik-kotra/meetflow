PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
GROQ_API_KEY=your_groq_api_key

# Short-term Cache Storage Integration
REDIS_URL=redis://127.0.0.1:6379
USE_MOCK_REDIS=false # set to true to force in-memory mock fallback in local dev

# Storage provider options: 'redis' or 's3'
STORAGE_PROVIDER=redis

# AWS S3 Storage (Future deployment plan)
S3_BUCKET_NAME=meetflow-recordings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
